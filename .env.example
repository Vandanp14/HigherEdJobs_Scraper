HEJ_DATABASE=data/jobs.sqlite3
# Requests are sequential, with this minimum delay between navigations.
HEJ_REQUEST_DELAY=2
# Company boards: seconds between requests to one ATS (minimum 0.5).
HEJ_BOARD_DELAY=1
# Company boards: skip postings older than this many days (0 = no limit).
HEJ_BOARD_MAX_AGE_DAYS=7
HEJ_HEADLESS=true
# Leave empty to use bundled Chromium. Set to chrome for installed Google Chrome.
HEJ_BROWSER_CHANNEL=
HEJ_CACHE_HOURS=24
HEJ_TIMEOUT_MS=30000
# Optional Playwright storage state captured by scripts/codegen.sh. Do not commit it.
HEJ_STORAGE_STATE=
# Master resume the For you tab ranks jobs against. Keep it under data/ so it is never committed.
HEJ_RESUME=data/resume.json
