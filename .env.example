HEJ_DATABASE=data/jobs.sqlite3
# Requests are sequential, with this minimum delay between navigations.
HEJ_REQUEST_DELAY=2
HEJ_HEADLESS=true
# Leave empty to use bundled Chromium. Set to chrome for installed Google Chrome.
HEJ_BROWSER_CHANNEL=
HEJ_CACHE_HOURS=24
HEJ_TIMEOUT_MS=30000
# Optional Playwright storage state captured by scripts/codegen.sh. Do not commit it.
HEJ_STORAGE_STATE=
